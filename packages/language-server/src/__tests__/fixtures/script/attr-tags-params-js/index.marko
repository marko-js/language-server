import Child from "<child>";

<child>
  <@foo bar/>
  <@foo|data|>
    ${data}
    //^?
  </@foo>
</child>

<Child>
  <@foo bar/>
  <@foo|data|>
    ${data}
    //^?
  </@foo>
</Child>

// This errors for now, because `typeof (some + expression)` is not allowed
<${true && Child}>
  <@foo bar/>
  <@foo|data|>
    ${data}
    //^?
  </@foo>
</>
// In a <for>: the body param typed (the wrong value is not reported, as nothing
// is in a JavaScript template)
<child>
  <for|n| of=[1, 2]>
    <@foo|data| bar="no">
      ${data}
      //^?
    </@foo>
  </for>
</child>
