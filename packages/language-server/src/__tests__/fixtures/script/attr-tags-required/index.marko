static const tuple = ["x", "y"] as const;
static const cols = ["x", "y"];
import ReqMenu from "./tags/req-menu/index.marko";
import RMenu from "./tags/rmenu/index.marko";
static const flag = Math.random() > 0.5;

// Every branch has it
<req-menu>
  <if=flag>
    <@req label="a"/>
  </if>
  <else>
    <@req label="b"/>
  </else>
</req-menu>

// Repeated, one with params (left out of TypeScript's first check)
<req-menu>
  <@req|n|>${n}</@req>
  <@req/>
</req-menu>

// Static, then possibly another
<req-menu>
  <@req|n|>${n}</@req>
  <if=flag>
    <@req/>
  </if>
</req-menu>

// Only in an <if>, with an attribute: given, though not by every render
<req-menu title="x">
  <if=flag>
    <@req/>
  </if>
</req-menu>

// Only in a while: given
<req-menu>
  <while=flag>
    <@req/>
  </while>
</req-menu>

// Only in an <if>, by a dynamic tag: given
<${ReqMenu}>
  <if=flag>
    <@req/>
  </if>
</>

// Only in an <if>, by one of several templates, with no other attribute: given
<${flag ? ReqMenu : RMenu}>
  <if=flag>
    <@req/>
  </if>
</>

// By a <define> tag
<define/Req|input: { req: Marko.AttrTag<{ content?: Marko.Body }> }|>
  <${input.req.content}/>
</define>

<Req>
  <@req/>
  <@req/>
</Req>

<Req>
  <if=flag>
    <@req/>
  </if>
</Req>

// An unknown attribute, with the attribute tag given
<req-menu bogus=1>
  <@req/>
  <@req/>
</req-menu>

// An input with an index signature
<idx-menu other=1>
  <@req/>
  <@req/>
</idx-menu>

<idx-menu other=1>
  <if=flag>
    <@req/>
  </if>
</idx-menu>

