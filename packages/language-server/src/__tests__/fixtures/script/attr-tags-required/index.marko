// Required only in a <for> over an array literal
<rmenu>
  <for|t| of=["x", "y"]>
    <@item label=t/>
  </for>
</rmenu>

// Required only in a <for> over a non-empty const tuple
<rmenu>
  <for|t| of=tuple>
    <@item label=t/>
  </for>
</rmenu>

// Required only in a <for to=3>
<rmenu>
  <for|i| to=3>
    <@item label=String(i)/>
  </for>
</rmenu>

// Required only in a <for> over a possibly empty list: given
<rmenu>
  <for|t| of=cols>
    <@item label=t/>
  </for>
</rmenu>

// Nested required, in an attribute tag in a loop
<rgrid>
  <for|i| of=[1, 2]>
    <@section>
      <@row label=`${i}`/>
      <@row/>
    </@section>
  </for>
</rgrid>
<rgrid>
  <for|i| of=[1, 2]>
    <@section>
      <for|j| of=[i]>
        <@row label=`${j}`/>
      </for>
    </@section>
  </for>
</rgrid>
<rgrid>
  <for|i| of=[1, 2]>
    <@section>
      <if=i === 2>
        <@row/>
      </if>
      <else>
        <@row/>
      </else>
    </@section>
  </for>
</rgrid>

// Given nowhere, by a tag with rest attribute tags => error
<idx-menu>
  <@other/>
  <@other/>
</idx-menu>
<idx-menu>
  <for|t| of=cols>
    <@other label=t/>
  </for>
</idx-menu>
// An attribute tag replaces a spread's attribute of its name, as Marko
// writes each attribute tag after the attributes (as nothing, if none is given).
static const spread = { title: "a", req: ["x", "y"] };
static const withReq = { req: { label: "a", *[Symbol.iterator]() {} } };
// The spread's is not checked: a <for> gives it
<req-menu ...spread>
  <for|label| of=tuple>
    <@req label=label/>
  </for>
</req-menu>
// The spread's is replaced by one that might be missing: given
<req-menu ...withReq>
  <if=flag>
    <@req label="a"/>
  </if>
</req-menu>
<req-menu ...withReq>
  <for|label| of=cols>
    <@req label=label/>
  </for>
</req-menu>
// The spread's other attributes are still checked => error
<req-menu ...{ title: 1 }>
  <for|label| of=tuple>
    <@req label=label/>
  </for>
</req-menu>
// Written once, it is the attribute already
<req-menu ...spread>
  <@req label="a"/>
  <if=flag>
    <@req label="b"/>
  </if>
</req-menu>
// An attribute of an attribute tag's name, the attribute tag in a <for>:
// reported as overwritten, as Marko replaces it with the attribute tag
<req-menu req=1>
  <for|label| of=tuple>
    <@req label=label/>
  </for>
</req-menu>

// A required nested attribute tag given only in an <if> with a scriptlet, and
// with its attribute tag in a <for>: given
<rgrid>
  <@section>
    <if=flag>
      $ const label = "a";
      <@row label=label/>
    </if>
  </@section>
</rgrid>
<rgrid>
  <for|label| of=cols>
    <@section>
      <if=flag>
        <@row label=label/>
      </if>
    </@section>
  </for>
</rgrid>
