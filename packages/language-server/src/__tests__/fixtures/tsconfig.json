{
  "include": ["./**/*"],
  // The fixture on Marko 6 sets up a project of its own: one program cannot
  // hold two runtimes' global `Marko`.
  "exclude": ["**/__snapshots__", "script/template-consumers-marko-6"],
  "compilerOptions": {
    "lib": ["ESNext", "dom"],
    "strict": true,
    "target": "ESNext",
    "sourceMap": false,
    "module": "ESNext",
    "skipLibCheck": true,
    "stripInternal": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noUnusedParameters": true,
    "allowUnusedLabels": false,
    "noImplicitReturns": false,
    "noImplicitOverride": true,
    "allowUnreachableCode": false,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true
  }
}
