{
  "name": "@marko/language-server",
  "version": "3.5.0",
  "description": "Marko Language Server",
  "keywords": [
    "autocomplete",
    "intellisense",
    "language",
    "marko",
    "server"
  ],
  "homepage": "https://github.com/marko-js/language-server/tree/main/packages/language-server/README.md",
  "bugs": "https://github.com/marko-js/language-server/issues/new?template=bug-report.yml",
  "repository": {
    "type": "git",
    "url": "https://github.com/marko-js/language-server/tree/main/packages/language-server"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.mjs",
      "default": "./dist/browser.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "bin": {
    "marko-language-server": "./bin.js"
  },
  "files": [
    "dist",
    "!**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsx build.mts",
    "test": "mocha './src/**/__tests__/*.test.ts'",
    "test:update": "mocha './src/**/__tests__/*.test.ts' --update"
  },
  "dependencies": {
    "@marko/compiler": "^5.43.2",
    "@marko/language-tools": "^2.8.0",
    "axe-core": "^4.14.0",
    "htmljs-parser": "^5.20.0",
    "jsdom": "^31.0.0",
    "marko": "^5.40.1",
    "prettier": "^3.10.1",
    "prettier-plugin-marko": "^4.1.3",
    "relative-import-path": "^1.0.1",
    "typescript": "^6.0.3",
    "vscode-css-languageservice": "^6.3.10",
    "vscode-languageserver": "^11.0.0",
    "vscode-languageserver-textdocument": "^1.0.16",
    "vscode-uri": "^3.2.0"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "tsx": "^4.23.15"
  }
}
